# Devin API 后端配置
# 默认会从 ~/.local/share/devin/credentials.toml 读取 api_server_url 和 token
DEVIN_BASE_URL=https://server.codeium.com
DEVIN_STREAM_PATH=/exa.api_server_pb.ApiServerService/GetChatMessage
DEVIN_UNARY_PATH=/exa.api_server_pb.ApiServerService/GetChatMessage

# 手动设置 token（会覆盖凭证文件）
# DEVIN_TOKEN=your_windsurf_api_key

# Connect 内容类型（当前实现基于 protobuf 手动编解码）
DEVIN_CONTENT_TYPE=application/connect+proto

# SDK / 标识头
DEVIN_SDK=raindrop-rust

# 模型映射与默认值
DEFAULT_DEVIN_MODEL=swe-1-7
# DEVIN_MODEL_MAP='{"gpt-4o":"swe-1-7"}'

# Devin 特有字段默认值
DEVIN_TOP_K=40

# 是否把远程图片 URL 下载并 base64 编码后发给模型
FETCH_IMAGE_URLS=true

# 是否在非流式请求中自动执行模型发起的 web_search 工具调用
# 启用后若模型调用 web_search，代理会调用 Devin 的 GetWebSearchResults 并自动带入结果继续对话
# AUTO_WEB_SEARCH=false

# 自动 web_search 的返回条数与最大调用轮数
# WEB_SEARCH_NUM_RESULTS=5
# WEB_SEARCH_MAX_ROUNDS=5

# 是否注入 Devin CLI 风格的系统提示、context 消息和内置工具列表
# 开启后会带上 system_info、rules、available_skills 以及 25 个内置工具定义
# DEVIN_CONTEXT=false

# 系统提示 / 工具定义存放目录（默认项目下的 devin_context/）
# DEVIN_CONTEXT_DIR=./devin_context

# 请求超时（秒）
PROXY_TIMEOUT=300

# 监听端口
PORT=8000
